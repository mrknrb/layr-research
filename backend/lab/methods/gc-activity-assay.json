{
 "id": "gc-activity-assay",
 "name": "GC-FID activity assay",
 "version": 1,
 "description": "Whole-cell activity assay measured by GC-FID: chromatograms → peaks at fixed retention times → internal-standard ratios → calibration → concentrations → specific activities (U/gCDW), mass balance and quality checks.",
 "inputs": [
  {
   "id": "raw",
   "kind": "file",
   "label": "GC sequence (GAML export)",
   "types": [
    ".gaml"
   ]
  }
 ],
 "params": [
  {
   "id": "channel",
   "type": "text",
   "label": "Detector channel",
   "default": null,
   "group": "Raw data",
   "help": "Trace name in the GAML file (e.g. BackDetectorFID); empty: the first trace."
  },
  {
   "id": "sample_patterns",
   "type": "patterns",
   "label": "Sample name patterns",
   "default": [
    {
     "role": "sample",
     "regex": "^Act\\.Assay_(?P<strain>[A-Za-z0-9]+)_(?P<time_min>\\d+)min_R(?P<replicate>\\d+)_(?P<substrate>[A-Za-z0-9]+)$"
    },
    {
     "role": "standard",
     "regex": "^.*_std_.*_(?P<std_conc_mM>[\\d.]+)mM (?P<std_series>[A-Z])$"
    },
    {
     "role": "blank",
     "regex": "^ether$"
    }
   ],
   "group": "Samples",
   "help": "One regular expression per role (sample, standard, blank); named groups become columns: strain, time_min, replicate, substrate, std_conc_mM, std_series."
  },
  {
   "id": "compounds",
   "type": "compounds",
   "label": "Compounds and retention times",
   "default": {},
   "group": "Compounds",
   "help": "Each compound with its expected retention time (min) and, if needed, its own tolerance."
  },
  {
   "id": "internal_standard",
   "type": "text",
   "label": "Internal standard",
   "default": null,
   "group": "Compounds",
   "help": "One of the compounds, e.g. octanol."
  },
  {
   "id": "rt_tolerance_min",
   "type": "number",
   "label": "Retention time tolerance",
   "default": 0.012,
   "group": "Integration",
   "help": "The apex must lie this close to the reference time.",
   "unit": "min"
  },
  {
   "id": "rt_drift_correction",
   "type": "boolean",
   "label": "Follow the internal standard's drift",
   "default": true,
   "group": "Integration"
  },
  {
   "id": "smoothing_points",
   "type": "integer",
   "label": "Smoothing window",
   "default": 11,
   "group": "Integration",
   "help": "Savitzky-Golay window (odd number of points)."
  },
  {
   "id": "max_half_width_min",
   "type": "number",
   "label": "Longest half-width",
   "default": 0.15,
   "group": "Integration",
   "unit": "min"
  },
  {
   "id": "lod_snr",
   "type": "number",
   "label": "Detection limit (S/N)",
   "default": 3,
   "group": "Integration"
  },
  {
   "id": "loq_snr",
   "type": "number",
   "label": "Quantification limit (S/N)",
   "default": 10,
   "group": "Integration"
  },
  {
   "id": "cal_min_conc_mM",
   "type": "number",
   "label": "Lowest standard used",
   "default": null,
   "group": "Calibration",
   "unit": "mM"
  },
  {
   "id": "cal_max_conc_mM",
   "type": "number",
   "label": "Highest standard used",
   "default": null,
   "group": "Calibration",
   "help": "Samples above it are extrapolated and flagged.",
   "unit": "mM"
  },
  {
   "id": "cal_series",
   "type": "list",
   "label": "Standard series used",
   "default": [],
   "group": "Calibration",
   "help": "e.g. A, B; empty: all."
  },
  {
   "id": "force_zero_intercept",
   "type": "boolean",
   "label": "Force calibration through zero",
   "default": false,
   "group": "Calibration"
  },
  {
   "id": "concentration_factor",
   "type": "number",
   "label": "Concentration factor",
   "default": 1.0,
   "group": "Activity",
   "help": "e.g. 500 µl intended / 550 µl cells added = 0.909."
  },
  {
   "id": "rate_window_min",
   "type": "list",
   "label": "Initial rate window",
   "default": [
    0,
    30
   ],
   "group": "Activity",
   "help": "Start and end of the linear range.",
   "unit": "min"
  },
  {
   "id": "biomass_gcdw_per_l",
   "type": "biomass",
   "label": "Biomass",
   "default": null,
   "group": "Activity",
   "help": "Cell dry weight in the assay: one number, or one per fed substrate.",
   "unit": "gCDW/L"
  },
  {
   "id": "is_area_tolerance_pct",
   "type": "number",
   "label": "Internal standard area tolerance",
   "default": 25,
   "group": "Checks",
   "unit": "%"
  },
  {
   "id": "shoulder_fwhm_ratio",
   "type": "number",
   "label": "Widest acceptable peak (x standards)",
   "default": 1.3,
   "group": "Checks"
  },
  {
   "id": "min_r2",
   "type": "number",
   "label": "Lowest acceptable calibration R²",
   "default": 0.995,
   "group": "Checks"
  },
  {
   "id": "max_residual_pct",
   "type": "number",
   "label": "Largest standard residual",
   "default": 15,
   "group": "Checks",
   "unit": "%"
  },
  {
   "id": "max_replicate_cv_pct",
   "type": "number",
   "label": "Largest replicate CV",
   "default": 20,
   "group": "Checks",
   "unit": "%"
  },
  {
   "id": "cv_min_conc_mM",
   "type": "number",
   "label": "CV checked above",
   "default": 0.02,
   "group": "Checks",
   "unit": "mM"
  },
  {
   "id": "mass_balance_range_pct",
   "type": "list",
   "label": "Mass balance range",
   "default": [
    80,
    120
   ],
   "group": "Checks",
   "unit": "% of t0"
  }
 ],
 "steps": [
  {
   "id": "read",
   "type": "gc.read_gaml",
   "inputs": {
    "file": "$raw"
   },
   "params": {
    "channel": "@channel"
   }
  },
  {
   "id": "names",
   "type": "gc.sample_names",
   "inputs": {
    "injections": "read.injections",
    "corrections": "$corrections"
   },
   "params": {
    "patterns": "@sample_patterns"
   }
  },
  {
   "id": "rts",
   "type": "gc.reference_rts",
   "inputs": {
    "injections": "read.injections",
    "samples": "names.samples"
   },
   "params": {
    "compounds": "@compounds",
    "rt_tolerance_min": "@rt_tolerance_min",
    "smoothing_points": "@smoothing_points",
    "max_half_width_min": "@max_half_width_min",
    "lod_snr": "@lod_snr",
    "loq_snr": "@loq_snr"
   }
  },
  {
   "id": "peaks",
   "type": "gc.integrate",
   "inputs": {
    "injections": "read.injections",
    "samples": "names.samples",
    "references": "rts.references",
    "corrections": "$corrections"
   },
   "params": {
    "compounds": "@compounds",
    "rt_tolerance_min": "@rt_tolerance_min",
    "smoothing_points": "@smoothing_points",
    "max_half_width_min": "@max_half_width_min",
    "lod_snr": "@lod_snr",
    "loq_snr": "@loq_snr",
    "internal_standard": "@internal_standard",
    "rt_drift_correction": "@rt_drift_correction"
   }
  },
  {
   "id": "ratio",
   "type": "gc.is_ratio",
   "inputs": {
    "peaks": "peaks.peaks"
   },
   "params": {
    "internal_standard": "@internal_standard"
   }
  },
  {
   "id": "cal",
   "type": "gc.calibrate",
   "inputs": {
    "ratios": "ratio.ratios"
   },
   "params": {
    "min_conc_mM": "@cal_min_conc_mM",
    "max_conc_mM": "@cal_max_conc_mM",
    "series": "@cal_series",
    "force_zero_intercept": "@force_zero_intercept"
   }
  },
  {
   "id": "conc",
   "type": "gc.quantify",
   "inputs": {
    "ratios": "ratio.ratios",
    "curves": "cal.curves"
   },
   "params": {
    "concentration_factor": "@concentration_factor"
   }
  },
  {
   "id": "tc",
   "type": "kin.time_course",
   "inputs": {
    "concentrations": "conc.concentrations"
   }
  },
  {
   "id": "rates",
   "type": "kin.initial_rates",
   "inputs": {
    "concentrations": "conc.concentrations"
   },
   "params": {
    "rate_window_min": "@rate_window_min",
    "biomass_gcdw_per_l": "@biomass_gcdw_per_l"
   }
  },
  {
   "id": "intervals",
   "type": "kin.interval_rates",
   "inputs": {
    "time_course": "tc.time_course"
   },
   "params": {
    "biomass_gcdw_per_l": "@biomass_gcdw_per_l"
   }
  },
  {
   "id": "balance",
   "type": "kin.mass_balance",
   "inputs": {
    "time_course": "tc.time_course"
   }
  },
  {
   "id": "qc",
   "type": "gc.qc",
   "inputs": {
    "peaks": "peaks.peaks",
    "references": "rts.references",
    "curves": "cal.curves",
    "points": "cal.points",
    "concentrations": "conc.concentrations",
    "time_course": "tc.time_course",
    "mass_balance": "balance.mass_balance",
    "design_flags": "names.flags"
   },
   "params": {
    "internal_standard": "@internal_standard",
    "is_area_tolerance_pct": "@is_area_tolerance_pct",
    "shoulder_fwhm_ratio": "@shoulder_fwhm_ratio",
    "min_r2": "@min_r2",
    "max_residual_pct": "@max_residual_pct",
    "max_replicate_cv_pct": "@max_replicate_cv_pct",
    "cv_min_conc_mM": "@cv_min_conc_mM",
    "mass_balance_range_pct": "@mass_balance_range_pct"
   }
  },
  {
   "id": "plot",
   "type": "plot.time_course",
   "inputs": {
    "time_course": "tc.time_course"
   }
  }
 ],
 "outputs": {
  "activities": {
   "from": "rates.activities",
   "database": true,
   "label": "Specific activities"
  },
  "time_course": {
   "from": "tc.time_course",
   "database": true,
   "label": "Time course"
  },
  "concentrations": {
   "from": "conc.concentrations",
   "database": true,
   "label": "Concentrations"
  },
  "interval_rates": {
   "from": "intervals.interval_rates",
   "database": true,
   "label": "Interval rates"
  },
  "mass_balance": {
   "from": "balance.mass_balance",
   "database": true,
   "label": "Mass balance"
  },
  "calibration": {
   "from": "cal.curves",
   "label": "Calibration lines"
  },
  "calibration_points": {
   "from": "cal.points",
   "label": "Calibration points"
  },
  "peaks": {
   "from": "peaks.peaks",
   "label": "Peaks"
  },
  "flags": {
   "from": "qc.flags",
   "label": "Quality flags"
  },
  "figure": {
   "from": "plot.figure",
   "label": "Time course figure"
  }
 }
}
