{
  "id": "research",
  "name": "Research",
  "version": "0.5.0",
  "description": "Explainable data analysis for any study: methods written as plain Python that explain every number from their own code (surveys, lab measurements, instrument exports...), each experiment's own pages built from cards, corrections with reasons, reports; plus quick charts and tests.",
  "author": "layr",
  "layr": "^0.1",
  "icon": "science",
  "permissions": ["data", "pc", "files"],
  "needs": ["pc", "python"],
  "connections": [
    { "plugin": "claude", "groups": ["ask"],
      "why": "Explain a function or selected lines in plain words, and draft a Methods paragraph (one-off questions to Claude)" }
  ],
  "panels": [
    { "id": "experiments", "title": "Experiments", "page": "panels/lab.html", "icon": "biotech", "opens": [".sav", ".dta"] },
    { "id": "main", "title": "Quick analysis", "page": "panels/main.html", "icon": "science" }
  ],
  "commands": [
    { "id": "experiments", "title": "Research: Experiments", "panel": "experiments" },
    { "id": "open", "title": "Research: Quick analysis", "panel": "main" },
    { "id": "sample", "title": "Research: Load the sample data", "tool": "load_sample" }
  ],
  "links": [{ "path": "open", "panel": "experiments", "param": "ref" }],
  "menus": [
    { "menu": "View", "command": "experiments" },
    { "menu": "View", "command": "open" },
    { "menu": "Tools", "command": "sample" }
  ],
  "backend": { "kind": "process", "runtime": "python", "entry": "backend/server.py" },
  "access": {
    "groups": [
      { "id": "read", "label": "See datasets, methods and their code, experiments, results, explanations",
        "tools": ["list_datasets", "preview", "describe", "plot", "ttest", "anova", "history", "get_plot",
                  "methods", "method_get", "method_check", "method_versions", "method_diff", "draft_get",
                  "toolbox_docs", "toolbox_copy", "explain", "explain_function", "ai_prompt", "experiments",
                  "experiment_get", "runs", "run_get", "result_table", "figure", "provenance", "compare_runs",
                  "curve", "result_value", "correction_kinds", "examples", "flow_get", "flow_edit", "flow_new",
                  "value_get", "function_inside", "loop_rounds", "blocks", "code_complete", "code_hover",
                  "code_signature", "code_definition", "code_rename", "code_format", "reference_get",
                  "reference_make"],
        "defaults": { "plugins": "allow", "agents": "allow" } },
      { "id": "load", "label": "Load data (also files from this PC) and create experiments",
        "tools": ["load_csv", "load_sample", "file_import", "file_fetch", "upload_chunk", "upload_finish",
                  "experiment_create", "lab_sample"],
        "defaults": { "agents": "allow" } },
      { "id": "build", "label": "Write methods (as drafts you approve), change and run experiments, write reports",
        "tools": ["method_create", "method_write", "method_declare", "method_revert", "method_reference", "experiment_update", "run",
                  "run_stop", "export", "method_export", "notebook"],
        "defaults": { "agents": "allow" } },
      { "id": "propose", "label": "Propose corrections (they wait for your approval)",
        "tools": ["correction_propose"],
        "defaults": { "agents": "allow" } },
      { "id": "approve", "label": "Approve or reject corrections and method drafts",
        "tools": ["correction_decide", "draft_decide"] },
      { "id": "remove", "label": "Delete datasets, experiments and methods",
        "tools": ["remove_dataset", "experiment_delete", "method_delete"] }
    ]
  }
}
