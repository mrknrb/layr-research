{
  "id": "research",
  "name": "Research",
  "version": "0.1.0",
  "description": "Load a CSV table, see its summary, draw charts and compare groups (t-test, ANOVA) with Python.",
  "author": "layr",
  "layr": "^0.1",
  "icon": "science",
  "permissions": ["data", "pc"],
  "needs": ["pc", "python"],
  "panels": [{ "id": "main", "title": "Research", "page": "panels/main.html", "icon": "science" }],
