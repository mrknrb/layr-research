{
  "id": "research",
  "name": "Research",
  "version": "0.1.1",
  "description": "Load a CSV table, see its summary, draw charts and compare groups (t-test, ANOVA) with Python.",
  "author": "layr",
  "layr": "^0.1",
  "icon": "science",
  "permissions": ["data", "pc"],
  "needs": ["pc", "python"],
  "panels": [{ "id": "main", "title": "Research", "page": "panels/main.html", "icon": "science" }],
  "commands": [
    { "id": "open", "title": "Research: Open", "panel": "main" },
    { "id": "sample", "title": "Research: Load the sample data", "tool": "load_sample" }
  ],
  "menus": [
    { "menu": "View", "command": "open" },
    { "menu": "Tools", "command": "sample" }
  ],
  "backend": { "kind": "process", "runtime": "python", "entry": "backend/server.py" },
  "access": {
    "groups": [
      { "id": "read", "label": "See datasets and results",
        "tools": ["list_datasets", "preview", "describe", "plot", "ttest", "anova", "history", "get_plot"],
        "defaults": { "plugins": "allow", "agents": "allow" } },
      { "id": "load", "label": "Load datasets (also from files on this PC)", "tools": ["load_csv", "load_sample"],
        "defaults": { "agents": "allow" } },
      { "id": "remove", "label": "Delete datasets", "tools": ["remove_dataset"] }
    ]
  }
}
